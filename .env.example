# Copia este archivo como .env y pon los datos de TU proyecto de Supabase
# (Project Settings → API Keys). Usa SOLO la llave publishable/anon, nunca la secret/service_role.
# Si las dejas vacías, la app funciona en modo local (localStorage + BroadcastChannel).
VITE_SUPABASE_URL=
VITE_SUPABASE_KEY=

# Challenge 17 (GIPHY). Crea tu llave en https://developers.giphy.com y pégala aquí.
# VITE_GIPHY_BASE es opcional (por defecto https://api.giphy.com/v1); sirve para apuntar al simulador local.
VITE_GIPHY_KEY=
VITE_GIPHY_BASE=
